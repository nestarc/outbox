{
  "name": "@nestarc/outbox",
  "version": "0.2.1",
  "description": "Prisma-native transactional outbox for NestJS — atomic event emission, polling with SKIP LOCKED, retry with backoff, @OnOutboxEvent() decorator.",
  "license": "MIT",
  "author": "nestarc",
  "homepage": "https://nestarc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestarc/outbox.git"
  },
  "bugs": {
    "url": "https://github.com/nestarc/outbox/issues"
  },
  "keywords": [
    "nestjs",
    "outbox",
    "outbox-pattern",
    "transactional-outbox",
    "prisma",
    "event",
    "dual-write",
    "polling",
    "nestarc"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:e2e": "npm run prisma:generate && jest --selectProjects e2e --runInBand",
    "test:all": "jest",
    "test:modern-consumer": "npm run build && node scripts/test-modern-consumer.js",
    "test:nest12-consumer": "npm run build && node scripts/test-modern-consumer.js --nest12",
    "test:nest12-candidate": "npm run build && node scripts/test-modern-consumer.js --nest12 --candidate-manifest",
    "test:prisma5-consumer": "npm run build && node scripts/test-prisma5-consumer.js",
    "test:prisma6-consumer": "npm run build && node scripts/test-prisma5-consumer.js --prisma6",
    "test:compatibility-policy": "node scripts/test-compatibility-policy.js",
    "test:workflow-policy": "node scripts/test-workflow-policy.js",
    "prisma:generate": "node scripts/generate-prisma-client.js",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/schedule": "^4.0.0 || ^5.0.0 || ^12.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/testing": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "pg": "8.20.0",
    "prettier": "^3.3.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.10",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
